# The API this site talks to.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:3001/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared with tripme_api so it can clear cached pages after an editor
# publishes — see server/api/revalidate.post.ts. Empty switches the endpoint
# off (404) rather than leaving it open.
NUXT_REVALIDATE_SECRET=
