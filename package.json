{
  "name": "tripme_app",
  "version": "1.0.0",
  "description": "TripMe",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "dev:api": "npm --prefix ../tripme_api run start",
    "dev:live": "npm --prefix ../tripme_api run start:live",
    "dev:all": "concurrently -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev\"",
    "dev:all:live": "concurrently -n api,web -c cyan,green \"npm run dev:live\" \"npm run dev\""
  },
  "author": "Javlon Khalimjonov",
  "license": "ISC",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "oxc-parser": "^0.146.0",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
